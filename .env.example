# Copy to .env (git-ignored). init-workspace does this and fills MASK_HMAC_KEY.
# Never commit real values.

# Optional: put the workspace outside the repository.
MAIL_PIPELINE_WORKSPACE=

# Secret for masked exports (HMAC of the email local part). Generated by init-workspace.
MASK_HMAC_KEY=

# providers/listmonk
LISTMONK_URL=
LISTMONK_USERNAME=
LISTMONK_API_TOKEN=
LISTMONK_LIST_ID=
